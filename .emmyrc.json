{
  "runtime": {
    "version": "LuaJIT",
    "requirePattern": [
      "lua/?.lua",
      "lua/?/init.lua",
      "?.lua",
      "?/init.lua"
    ],
    "special": {
      "applet_expect": "assert"
    }
  },
  "workspace": {
    "library": [
      ".deps/typecheck/neovim/runtime/lua",
      ".deps/typecheck/luv/library",
      ".deps/typecheck/luassert/library"
    ],
    "ignoreGlobs": [
      "**/.git/**",
      "**/.deps/**",
      "**/.test-data/**",
      "**/.coverage/**"
    ]
  },
  "strict": {
    "arrayIndex": true,
    "requirePath": true,
    "typeCall": true
  },
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/0.25.1/crates/emmylua_code_analysis/resources/schema.json",
  "diagnostics": {
    "severity": {
      "unnecessary-if": "hint",
      "unnecessary-assert": "hint"
    }
  }
}
